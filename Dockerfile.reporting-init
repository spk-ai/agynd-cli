#
# The agynd init image for workloads whose environment runs Node-based init
# scripts and terminal commands without a Node of its own: execution reporting
# runs /agyn/bin/node in the main container, before and beside the agent CLI.
# It is Dockerfile.init's delivery plus Node, published per commit by
# .github/workflows/publish-image.yml for installations to pin by digest.
#
# tmux, its terminfo and tmux.conf come unchanged from the released 0.24.2
# init image (built by Dockerfile.init from the same tmux.conf); agynd and its
# trace hook are rebuilt from this revision. Every image is pinned to the
# index digest of its tag; update each tag and digest together.
ARG BUF_VERSION=1.66.0
# Release sha256.txt entries for buf-Linux-x86_64 and buf-Linux-aarch64.
ARG BUF_SHA256_X86_64=32e8e7b236e1b9da4eb20ad3c7701a404f7909b18d60f6d00837c63b31d4e6cf
ARG BUF_SHA256_AARCH64=f8a77dbcbf492836e0e1bca2f2c9dbb5392a5bb47db161be89d811f36b86ee30

# golang:1.26-alpine was Go 1.26.8 on 2026-10-04.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS build
ARG BUF_VERSION BUF_SHA256_X86_64 BUF_SHA256_AARCH64
RUN apk add --no-cache curl git
RUN set -eu; \
    arch="$(uname -m)"; \
    case "${arch}" in \
      x86_64) sha256="${BUF_SHA256_X86_64}" ;; \
      aarch64) sha256="${BUF_SHA256_AARCH64}" ;; \
      *) echo "no pinned buf checksum for ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/bufbuild/buf/releases/download/v${BUF_VERSION}/buf-Linux-${arch}" -o /usr/local/bin/buf; \
    echo "${sha256}  /usr/local/bin/buf" | sha256sum -c -; \
    chmod +x /usr/local/bin/buf

WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download && go mod verify
# buf.gen.yaml pins the spk-ai/api revision the bindings are generated from.
COPY buf.gen.yaml ./
RUN buf generate --include-imports --template buf.gen.yaml
COPY cmd ./cmd
COPY internal ./internal

ARG TARGETOS TARGETARCH
ARG AGYND_VERSION=dev
# Statically linked, so it runs on any Linux base image the workspace uses.
ENV CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOFLAGS=-mod=readonly
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -buildvcs=false -ldflags "-s -w -X main.version=${AGYND_VERSION}" -o /out/agynd ./cmd/agynd && \
    go build -trimpath -buildvcs=false -ldflags "-s -w" -o /out/agynd-trace-hook ./cmd/agynd-trace-hook

# Node is glibc-linked: it runs in glibc workspace images (Debian, Ubuntu,
# RHEL families) with the C++ runtime it was built against beside it, not on
# musl. The node:22 Debian 12 runtime needs glibc 2.28 or newer.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS node
RUN mkdir /node-libs && cp -L /usr/lib/*-linux-gnu/libstdc++.so.6 /usr/lib/*-linux-gnu/libgcc_s.so.1 /node-libs/

FROM ghcr.io/agynio/agynd-cli-init:0.24.2@sha256:bb8e8527c19fbe3b8533df0f423c9a9032c2bac29cc726c17ffb6145b4481d62
COPY --from=build /out/agynd /opt/agyn/agynd
COPY --from=build /out/agynd-trace-hook /opt/agyn/agynd-trace-hook
COPY --from=node /usr/local/bin/node /opt/agyn/node.bin
COPY --from=node /node-libs/ /opt/agyn/node-libs/
# /agyn/bin/node is the stable path init scripts and terminal commands run.
COPY --chmod=0755 node-wrapper.sh /opt/agyn/node

# Workloads run every container as UID/GID 10001 under the restricted Pod
# profile; the emptyDir at /agyn is world-writable, so nothing here needs root,
# and the copies stay owned by the workload user that later runs them.
USER 10001:10001
ENTRYPOINT ["/bin/sh", "-c", "set -e; \
mkdir -p /agyn/bin /agyn/lib /agyn/terminfo /agyn/run; \
chmod 0777 /agyn/run; \
cp /opt/agyn/agynd /opt/agyn/agynd-trace-hook /opt/agyn/tmux /opt/agyn/node /opt/agyn/node.bin /agyn/bin/; \
chmod 0755 /agyn/bin/agynd /agyn/bin/agynd-trace-hook /agyn/bin/tmux /agyn/bin/node /agyn/bin/node.bin; \
cp /opt/agyn/node-libs/* /agyn/lib/; \
cp -R /opt/agyn/terminfo/. /agyn/terminfo/; \
cp /opt/agyn/tmux.conf /agyn/tmux.conf; chmod 0644 /agyn/tmux.conf"]
